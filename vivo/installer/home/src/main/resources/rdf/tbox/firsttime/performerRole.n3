@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix uncw:  <https://scholars.uncw.edu/ontology/> .

# A person's role in a performance, exhibit, or competition (WFS PERFORM_EXHIBIT
# records). Kept separate from vivo:PresenterRole so these get their own
# "performances" section on profiles; see display/everytime/performancesPropertyConfig.n3.
uncw:PerformerRole  a    owl:Class ;
        rdfs:label       "Performer Role"@en-US ;
        rdfs:subClassOf  obo:BFO_0000023 ;
        obo:IAO_0000115  "A role of performing, exhibiting, or competing in a creative or artistic event"@en-US .
