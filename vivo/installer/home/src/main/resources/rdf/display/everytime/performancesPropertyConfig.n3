@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://vitro.mannlib.cornell.edu/ns/vitro/ApplicationConfiguration#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vitro: <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#> .
@prefix role:  <http://vitro.mannlib.cornell.edu/ns/vitro/role#> .
@prefix local: <http://vitro.mannlib.cornell.edu/ns/vitro/siteConfig/> .

# "performances and exhibitions" section on person profiles: faux property of
# obo:RO_0000053 (bearer of) restricted to uncw:PerformerRole. Modeled on
# local:hasPresenterRoleConfig in display/firsttime/PropertyConfig.n3, and shown on
# the "creative works" tab (applicationMetadata/firsttime/uncw_propertygroups.n3).
#
# warning: don't use blank nodes; the display model doesn't currently support them.

local:hasPerformerRoleContext a :ConfigContext ;
    :hasConfiguration local:hasPerformerRoleConfig ;
    :configContextFor <http://purl.obolibrary.org/obo/RO_0000053> ;
    :qualifiedByDomain  <http://xmlns.com/foaf/0.1/Person>  ;
    :qualifiedBy      <https://scholars.uncw.edu/ontology/PerformerRole> .

local:hasPerformerRoleConfig a :ObjectPropertyDisplayConfig ;
    :listViewConfigFile "listViewConfig-hasPerformerRole.xml"^^xsd:string ;
    rdfs:label "hasPerformerRole"@en-US;
    :displayName "performances and exhibitions" ;
    vitro:collateBySubclassAnnot
              "true"^^xsd:boolean;
    vitro:displayRankAnnot 31;
    vitro:hiddenFromDisplayBelowRoleLevelAnnot role:public ;
    vitro:prohibitedFromUpdateBelowRoleLevelAnnot role:public ;
    :propertyGroup <https://scholars.uncw.edu/ontology/propertyGroupCreativeWorks> .
