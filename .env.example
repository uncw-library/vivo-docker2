# Copy to .env and adjust. .env is gitignored; keep secrets there only.

# ---- runtime.properties (rendered by vivo/docker-entrypoint.sh) ----
# required
VIVO_DEFAULT_NAMESPACE=https://scholars.uncw.edu/individual/
VIVO_ROOT_EMAIL=libsystems@uncw.edu
# defaults to http://vivo-solr:8983/solr/vivocore
SOLR_URL=http://vivo-solr:8983/solr/vivocore

# optional: leave empty to omit the property entirely
SMTP_HOST=
SMTP_PORT=
SMTP_REPLY_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_WEBAPP_BASE_URL=
ORCID_API=
ORCID_API_LEVEL=
GOOGLE_MAPS_KEY=

# ---- JVM / container (read directly by catalina.sh) ----
CATALINA_OPTS="-Xms1g -Xmx5g -XX:MaxMetaspaceSize=512m"
TZ=America/New_York
